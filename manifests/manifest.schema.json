{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nothing SM7635 kernel build manifest",
  "type": "object",
  "required": [
    "schema",
    "devices",
    "codename",
    "soc",
    "android",
    "kernel",
    "toolchain",
    "kernelsu",
    "susfs",
    "compatibility_patches",
    "anykernel3"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "device",
          "name",
          "model"
        ],
        "properties": {
          "device": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "codename": {
      "type": "string"
    },
    "soc": {
      "const": "sm7635"
    },
    "android": {
      "const": "android14-6.1"
    },
    "kernel": {
      "type": "object",
      "required": [
        "repository",
        "branch",
        "defconfig",
        "image"
      ]
    },
    "toolchain": {
      "type": "object",
      "required": [
        "repository",
        "branch",
        "version"
      ]
    },
    "kernelsu": {
      "type": "object",
      "required": [
        "repository",
        "branch"
      ]
    },
    "susfs": {
      "type": "object",
      "required": [
        "repository",
        "branch",
        "patch"
      ]
    },
    "compatibility_patches": {
      "type": "object",
      "required": [
        "repository",
        "commit"
      ]
    },
    "anykernel3": {
      "type": "object",
      "required": [
        "repository",
        "commit"
      ]
    }
  },
  "additionalProperties": false
}
